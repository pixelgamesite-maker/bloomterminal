# Bloom Terminal — environment variables
# Copy to .env.local and fill in. Everything is optional for the current
# mock-state build; these become required as the real backend/web3 is wired.

# --- Supabase (auth + database) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Web3 / wallet ---
# WalletConnect project id (free at https://cloud.walletconnect.com).
# RainbowKit needs this even to boot once wallet connect is wired in.
VITE_WALLETCONNECT_PROJECT_ID=
# The chain Bloom settles on. Fill id + RPC when confirmed.
VITE_CHAIN_ID=
VITE_CHAIN_RPC_URL=
